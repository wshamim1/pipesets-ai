          "legendFormat": "p50 {{app}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (app, le) (rate(pipesets_run_duration_seconds_bucket{app=~\"$app\"}[5m])))",
          "legendFormat": "p95 {{app}}"
