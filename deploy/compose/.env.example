# Copy to `.env` and fill in. Used by compose.yaml.
FRONTEND_PORT=8080
BACKEND_PORT=8000

# ── Edge (compose.edge.yaml only): TLS and network isolation ─────────────────
# Two DNS names pointing at this host. PUBLIC_HOST serves /v1/* only; UI_HOST serves the UI.
PUBLIC_HOST=
UI_HOST=
# Let's Encrypt account email; LETSENCRYPT_STAGING=1 while trying it out (untrusted certs)
LETSENCRYPT_EMAIL=
LETSENCRYPT_STAGING=0

# ── App database ─────────────────────────────────────────────────────────────
# Empty = SQLite file (SQLITE_DB_PATH, default backend/pipesets.db). Otherwise any SQLAlchemy URL:
#   postgresql+psycopg2://user:pass@host:5432/agentic
#   mssql+pyodbc://user:pass@host/agentic?driver=ODBC+Driver+18+for+SQL+Server   (needs pyodbc + ODBC driver)
# The schema is created/upgraded at startup, or explicitly with `python manage.py db setup`.
DATABASE_URL=

# Encrypts the Secrets vault. Required: without it secrets are lost when the container is recreated.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PIPESETS_MASTER_KEY=

DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# For Ollama running on the host from a container, use e.g. http://host.docker.internal:11434
# (podman: http://host.containers.internal:11434)
LLM_BASE_URL=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_REDACT=0

# Shared secret between the backend and the sandbox runner. Required.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SANDBOX_TOKEN=
# 1 (default): Python tools fail rather than run unisolated if the sandbox runner is down
SANDBOX_REQUIRE_ISOLATION=1
EXTERNAL_AGENT_ALLOW_PRIVATE=0
EXTERNAL_AGENT_ALLOWED_HOSTS=
# Days audit log entries are kept; 0 = forever
AUDIT_RETENTION_DAYS=365
