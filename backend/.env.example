# Default Provider: openai | anthropic | ollama | llamacpp | jan | mock
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4
DEFAULT_LLM_TEMPERATURE=0.7
DEFAULT_LLM_MAX_TOKENS=1024
DEFAULT_LLM_TOP_P=1.0

# ── App database ─────────────────────────────────────────────────────────────
# Empty = SQLite file (SQLITE_DB_PATH, default backend/pipesets.db). Otherwise any SQLAlchemy URL:
#   postgresql+psycopg2://user:pass@host:5432/agentic
#   mssql+pyodbc://user:pass@host/agentic?driver=ODBC+Driver+18+for+SQL+Server   (needs pyodbc + ODBC driver)
# The schema is created/upgraded at startup, or explicitly with `python manage.py db setup`.
DATABASE_URL=

# ── Secrets vault ────────────────────────────────────────────────────────────
# Encrypts the API keys saved under Secrets. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate: put the new key first (new,old), restart, run `python manage.py rotate-secrets`, then drop the old.
# Empty = a key is generated into backend/.secrets_master_key (local dev only — back it up; losing it loses the secrets).
PIPESETS_MASTER_KEY=
# Or keep the master key in a KMS instead of plaintext env (services/master_key.py):
#   AWS KMS:  PIPESETS_MASTER_KEY_KMS=<output of `python manage.py kms-wrap-key --key-id alias/pipesets`>
#   Vault KV: VAULT_ADDR, VAULT_TOKEN, PIPESETS_MASTER_KEY_VAULT_PATH=secret/data/pipesets
#             (PIPESETS_MASTER_KEY_VAULT_FIELD defaults to master_key)
# PIPESETS_MASTER_KEY_PROVIDER=env|aws_kms|vault  — inferred from which of the above is set

# API Keys (optional if provided via UI)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Other hosted providers (all optional; a node's key or the vault's default key wins)
# GROQ_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# TOGETHERAI_API_KEY=
# FIREWORKS_AI_API_KEY=
# HF_TOKEN=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# CEREBRAS_API_KEY=
# PERPLEXITY_API_KEY=
# COHERE_API_KEY=
# AZURE_API_KEY=
# NVIDIA NIM (hosted API catalog; NVIDIA_NIM_API_BASE for a self-hosted NIM)
# NVIDIA_NIM_API_KEY=
# IBM watsonx.ai: API key, region URL and the project calls run in
# WATSONX_APIKEY=
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_PROJECT_ID=

# Optional custom base url (e.g., http://localhost:11434 for Ollama, http://localhost:8080 for llama.cpp, or vLLM)
LLM_BASE_URL=

# ── LLM gateway backend (backend/llm/) ───────────────────────────────────────
# Which backend sends model calls: auto (default — our own adapter for every provider) |
# openai_compat | anthropic | gemini | bedrock | watsonx | litellm (if installed).
# A backend that can't serve a provider falls back to auto. LLM_BACKEND_<PROVIDER> overrides
# per provider, e.g. LLM_BACKEND_OPENAI. LiteLLM is a legacy fallback only.
LLM_BACKEND=
# LLM_BACKEND_OPENAI=litellm
# Server-wide base URLs for the openai_compat backend (a node's base URL wins)
# OPENAI_API_BASE=https://api.openai.com/v1
# MISTRAL_API_BASE=https://api.mistral.ai/v1
# TOGETHER_API_BASE=https://api.together.xyz/v1
# FIREWORKS_API_BASE=https://api.fireworks.ai/inference/v1
# HUGGINGFACE_API_BASE=https://router.huggingface.co/v1
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# XAI_API_BASE=https://api.x.ai/v1
# CEREBRAS_API_BASE=https://api.cerebras.ai/v1
# PERPLEXITY_API_BASE=https://api.perplexity.ai
# COHERE_API_BASE=https://api.cohere.ai/compatibility/v1
# Azure has no shared default: its resource endpoint is required
# AZURE_API_BASE=https://my-resource.openai.azure.com
# AZURE_API_VERSION=2024-10-21
# OLLAMA_API_BASE=http://localhost:11434
# LLAMACPP_API_BASE=http://127.0.0.1:8080

# ── Langfuse trace export (optional) ─────────────────────────────────────────
# Set both keys to mirror every run trace to Langfuse (cloud or self-hosted).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# 1 = send only model/tokens/cost/latency; omit prompt, output and tool I/O text
LANGFUSE_REDACT=0

# ── Python sandbox (optional) ────────────────────────────────────────────────
# 1 = never fall back to an un-isolated local subprocess when no podman/docker
#     engine is reachable; the tool returns an error instead. Also makes custom
#     tools run in a container and disables package installs.
SANDBOX_REQUIRE_ISOLATION=0
# Where custom tool code runs. Always a separate process with a scrubbed environment.
#   local (default)  backend's Python, so installed packages work; can still read the backend's files
#   container        podman/docker with network on; only CUSTOM_TOOL_IMAGE's packages
#   auto             container if an engine is reachable, otherwise local
CUSTOM_TOOL_SANDBOX=
CUSTOM_TOOL_IMAGE=python:3.12-slim
CUSTOM_TOOL_TIMEOUT=30
CUSTOM_TOOL_MEMORY_MB=1024

# ── External agents (optional) ───────────────────────────────────────────────
# External child agents are blocked from reaching private/loopback addresses (SSRF guard).
# 1 = allow any host; or list specific hosts (comma separated) to allow.
EXTERNAL_AGENT_ALLOW_PRIVATE=0
EXTERNAL_AGENT_ALLOWED_HOSTS=

# Public base URL of the backend (behind a proxy). Remote MCP servers' OAuth sign-in redirects to
# <PIPESETS_PUBLIC_URL>/api/custom-mcp/oauth/callback. Empty = the request's own URL.
PIPESETS_PUBLIC_URL=

# ── Login / sessions ─────────────────────────────────────────────────────────
# session (default): every /api route requires signing in.
# headers: legacy dev mode — without a session, trust x-user-id/x-tenant-id headers.
AUTH_MODE=session
# 0 = disable self-service sign-up (admins add users from IAM instead)
AUTH_ALLOW_SIGNUP=1
AUTH_SESSION_TTL_HOURS=168

# ── Scheduled pipeline runs ──────────────────────────────────────────────────
# Runs published pipelines on cron schedules (Build → Schedules, Monitor → Schedules).
# Replicas sharing one DB never double-fire, but set false on all but one to keep
# "interrupted run" cleanup on restart accurate.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=30
SCHEDULER_MAX_CONCURRENT=3
# Shortest allowed gap between runs of one schedule
SCHEDULER_MIN_INTERVAL_SECONDS=300

# ── Audit log ─────────────────────────────────────────────────────────────────
# Days admin-action entries are kept (Settings → Audit log); purged at startup and daily, and
# each purge is itself logged. 0 keeps everything. Tenants can read and export, never shorten it.
AUDIT_RETENTION_DAYS=365

# ── Browser access (CORS) ────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API from a browser. The deployed UI goes
# through the frontend proxy (same origin) and needs none. * = allow any origin.
# Empty/unset = the Vite dev server (http://localhost:5173, http://127.0.0.1:5173).
CORS_ORIGINS=
# Comma-separated Host header values to accept (e.g. api.example.com); unset = any.
ALLOWED_HOSTS=
